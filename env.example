# Copie este arquivo para .env quando for rodar FORA do Docker (npm run dev).
# Dentro do docker-compose essas variáveis já estão definidas no serviço "app".

# Banco MySQL. Rodando localmente (fora do Docker), o host costuma ser localhost.
DATABASE_URL="mysql://root:root@localhost:3306/projeto_integrador"

# Segredo usado para assinar os tokens JWT. Use um valor longo e aleatório.
JWT_SECRET="troque_este_segredo"
